{
  "name": "farm2future",
  "version": "1.0.0",
  "description": "Farm2Future - Smart Farmer Marketplace",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace=frontend",
    "dev": "node -e \"if (!require('fs').existsSync('frontend/build/index.html')) { require('child_process').execSync('npm run build', {stdio: 'inherit'}); }\" && node backend/server.js",
    "start": "node backend/server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "uuid": "^9.0.0"
  },
  "keywords": [
    "agriculture",
    "farmer",
    "marketplace",
    "Karnataka"
  ],
  "author": "Farm2Future"
}
